# URL base del backend. LOCAL: apunta directo a productos/pedidos-service o a Nginx.
# AWS: apunta a la Invoke URL de API Gateway.
VITE_API_URL=http://localhost:8080

# Configuración de Amazon Cognito (User Pool creado según el README, sección "Configuración Cognito")
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Parcial 2: URL de mensajeria-admin. Vacío = usa VITE_API_URL (API Gateway / Nginx enruta /api/admin).
# Local sin Nginx: http://localhost:8090
VITE_ADMIN_API_URL=
