# Copia este archivo como .env (está en .gitignore: nunca se sube) y completa los valores.

# --- Cognito (Parcial 1, sección 7 del README) ---
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
CORS_ALLOWED_ORIGINS=http://localhost:3000
VITE_API_URL=
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Parcial 2: mensajería SNS/SQS ---
# Credenciales del Learner Lab (AWS Details -> AWS CLI -> Show). Vencen con la sesión del lab.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# true = /api/admin/** exige JWT de un usuario del grupo ADMIN. false = abierto (solo para probar con Swagger).
SEGURIDAD_HABILITADA=true
# true = simula que el proveedor de correo está caído (demo de reintentos y DLQ en notificaciones).
SIMULAR_FALLO_CORREO=false
